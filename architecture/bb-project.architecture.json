      "dot": "cyan",
      "title": "Offline processing",
      "items": [
        "A reusable snapshot records source hashes, extracted claims, reconciled encounters, and audit findings.",
        "A changed source or model invalidates snapshot reuse."
      ]
    },
    {
      "dot": "violet",
      "title": "Online investigation",
      "items": [
        "The agent can search and open original lines, inspect related mentions, scan inventories, and read calculated views.",
        "The model chooses tools within a bounded call budget."
      ]
    },
    {
      "dot": "emerald",
      "title": "Review trail",
      "items": [
        "Markdown reports contain the question, answer, and cited original lines.",
        "Each run saves model usage, tool results, source hashes, and stage-specific call counts."
      ]
    }
